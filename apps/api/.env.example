# ==============================================================================
# BILLING SAAS - BACKEND API ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.101:3000
LOG_QUERIES=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# For Local Zero-Dependency Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production PostgreSQL (e.g., Supabase, Neon, AWS RDS, DigitalOcean):
# DATABASE_URL="postgresql://billing_user:StrongPassword@localhost:5432/billing_saas?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate 32+ character random strings: `openssl rand -base64 32`
JWT_SECRET=change_me_in_production_jwt_secret_min_32_chars_long_12345
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_min_32_chars_67890
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Cashfree Payments - For SaaS subscriptions & UPI billing)
# Get keys from: https://merchant.cashfree.com/merchants/login -> Developers -> API Keys
# ------------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST # Change to 'PROD' for live payments

# ------------------------------------------------------------------------------
# 5. WHATSAPP CLOUD API (Meta for Developers - Send digital bills via WhatsApp)
# Setup at: https://developers.facebook.com -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=billing_saas_webhook_secret_verify_token

# ------------------------------------------------------------------------------
# 6. CLOUD STORAGE (S3 / Cloudflare R2 - For PDF bills & barcode labels)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=billing-saas-files
S3_PUBLIC_URL=https://files.yourdomain.com
