# Environment variables — copy to .env and fill in real values
# NEVER commit the real .env file

# PostgreSQL
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=billing_pass
POSTGRES_DB=billing_saas

# Redis
REDIS_PASSWORD=redis_pass

# JWT (generate strong secrets for production)
JWT_SECRET=change_me_in_production_at_least_32_chars_long
JWT_REFRESH_SECRET=change_refresh_in_production_at_least_32_chars

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Database URL (used by Prisma directly)
DATABASE_URL=postgresql://billing_user:billing_pass@localhost:5432/billing_saas

# Redis URL
REDIS_URL=redis://:redis_pass@localhost:6379

# Cashfree (use test keys for development)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# S3 / Cloudflare R2 (for PDF and barcode label storage)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=billing-saas-files
S3_PUBLIC_URL=https://files.yourapp.com

# App base URL (used in bill PDF links sent via WhatsApp)
APP_BASE_URL=http://localhost:3000
